{
  "experiment_id": "desk_objects_experiment",
  "display_name": "Multi-Zone Item Transfer Protocol",
  "expected_duration_seconds": 60,
  "objects": [
    "book",
    "notebook",
    "bottle",
    "cup",
    "phone",
    "laptop",
    "hand"
  ],
  "rois": {
    "staging_zone": [20, 40, 220, 220],
    "log_zone": [100, 120, 540, 460],
    "storage_zone": [420, 40, 620, 220]
  },
  "steps": [
    {
      "id": 1,
      "name": "pickup_and_log_notebook",
      "requires_objects": ["book"],
      "event": "object_in_roi:book:log_zone|object_stationary_in_roi:book:log_zone|object_in_roi:notebook:log_zone|object_in_roi:laptop:log_zone",
      "voice_prompt": "Step 1: Pick up the notebook and place it in the logging zone.",
      "severity": 0.4,
      "irreversible": false,
      "verification": {
        "mode": "vision_only",
        "signal": null
      },
      "expected_targets": ["log_zone"],
      "confusable_targets": ["staging_zone", "storage_zone"]
    },
    {
      "id": 2,
      "name": "move_notebook_to_staging",
      "requires_objects": ["book"],
      "event": "object_transferred:book:log_to_staging|object_in_roi:book:staging_zone|object_stationary_in_roi:book:staging_zone|object_in_roi:notebook:staging_zone",
      "depends_on": [1],
      "voice_prompt": "Step 2: Move the notebook from the logging zone to the staging zone.",
      "severity": 0.5,
      "irreversible": false,
      "verification": {
        "mode": "vision_only",
        "signal": null
      },
      "expected_targets": ["staging_zone"],
      "confusable_targets": ["log_zone", "storage_zone"]
    },
    {
      "id": 3,
      "name": "pickup_and_log_bottle",
      "requires_objects": ["bottle"],
      "event": "object_in_roi:bottle:log_zone|object_stationary_in_roi:bottle:log_zone",
      "depends_on": [2],
      "voice_prompt": "Step 3: Pick up the bottle and place it in the logging zone.",
      "severity": 0.6,
      "irreversible": false,
      "verification": {
        "mode": "vision_only",
        "signal": null
      },
      "expected_targets": ["log_zone"],
      "confusable_targets": ["staging_zone", "storage_zone"]
    },
    {
      "id": 4,
      "name": "move_bottle_to_staging",
      "requires_objects": ["bottle"],
      "event": "object_transferred:bottle:log_to_staging|object_in_roi:bottle:staging_zone|object_stationary_in_roi:bottle:staging_zone",
      "depends_on": [3],
      "voice_prompt": "Step 4: Move the bottle from the logging zone to the staging zone.",
      "severity": 0.7,
      "irreversible": false,
      "verification": {
        "mode": "vision_only",
        "signal": null
      },
      "expected_targets": ["staging_zone"],
      "confusable_targets": ["storage_zone", "log_zone"]
    },
    {
      "id": 5,
      "name": "pickup_and_log_phone",
      "requires_objects": ["phone"],
      "event": "object_in_roi:phone:log_zone|object_stationary_in_roi:phone:log_zone|object_in_roi:phone:staging_zone|object_stationary_in_roi:phone:staging_zone",
      "depends_on": [4],
      "voice_prompt": "Step 5: Pick up the phone and place it in the logging zone.",
      "severity": 0.7,
      "irreversible": false,
      "verification": {
        "mode": "vision_only",
        "signal": null
      },
      "expected_targets": ["log_zone"],
      "confusable_targets": ["storage_zone"]
    },
    {
      "id": 6,
      "name": "transfer_cup_to_storage",
      "requires_objects": ["cup"],
      "event": "object_transferred:cup:staging_to_storage|object_transferred:cup:log_to_storage|object_in_roi:cup:storage_zone|object_stationary_in_roi:cup:storage_zone|object_transferred:bottle:staging_to_storage|object_in_roi:bottle:storage_zone|object_in_roi:book:storage_zone",
      "depends_on": [5],
      "voice_prompt": "Step 6: Pick up the cup and place it in the storage zone to complete the protocol.",
      "severity": 0.95,
      "irreversible": true,
      "verification": {
        "mode": "vision_only",
        "signal": null
      },
      "expected_targets": ["storage_zone"],
      "confusable_targets": ["staging_zone", "log_zone"]
    }
  ]
}
